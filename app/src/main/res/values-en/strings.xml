    <!-- Dialog 1: Welcome / Onboarding -->
    <string name="dialog_welcome_title">Welcome to Let It Snow! ❄️</string>
    <string name="dialog_welcome_text">The app brings a cozy winter snowfall right onto your screen.\n\nYou can enable falling snow over all apps or enjoy it inside the app window.</string>
    <string name="dialog_welcome_btn_overlay">Show over screen ❄️</string>
    <string name="dialog_welcome_btn_in_app">Only in app</string>

    <!-- Dialog 2: Overlay Permission Rationale -->
    <string name="dialog_overlay_rationale_title">Display over other apps</string>
    <string name="dialog_overlay_rationale_text">To let snowflakes swirl across your home screen and over other apps, a system permission is required.\n\nIn the system settings that open, find “Let It Snow” and toggle the switch on.</string>
    <string name="dialog_overlay_rationale_btn_settings">Open settings</string>
    <string name="dialog_overlay_rationale_btn_cancel">Cancel</string>

    <!-- Dialog 3: Overlay Permission Denied -->
    <string name="dialog_overlay_denied_title">Permission not granted</string>
    <string name="dialog_overlay_denied_text">Without this permission, display over other apps is unavailable. Snowfall will continue to delight you inside the app.\n\nYou can always enable the overlay later in the settings menu.</string>
    <string name="dialog_overlay_denied_btn_retry">Try again</string>
    <string name="dialog_overlay_denied_btn_ok">Got it</string>

    <!-- Dialog 4: Notification Permission Rationale -->
    <string name="dialog_notification_rationale_title">Service notification</string>
    <string name="dialog_notification_rationale_text">Allow notifications to see the snowfall status and quickly stop it right from the notification shade.</string>
    <string name="dialog_notification_rationale_btn_continue">Continue</string>
    <string name="dialog_notification_rationale_btn_not_now">Not now</string>

